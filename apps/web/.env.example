DATABASE_URL="postgresql://postgres:postgres@localhost:5432/werkpass?schema=public"

BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://dev-host.local:3000"
# Separate 32-byte key (Base64 or 64 hex chars) for OIDC/SAML provider secrets.
# Generate with: openssl rand -base64 32
SSO_CONFIG_ENCRYPTION_KEY=""
# Only enable behind a trusted reverse proxy that overwrites these headers.
TRUST_PROXY_HEADERS="false"
DEV_ALLOWED_ORIGINS="dev-host.local"
APP_ORIGINS="http://localhost:3000,http://dev-host.local:3000"

# Local dev: Garage via docker-compose.dev.yml (see infra/garage/README setup
# steps). Production points these at Hetzner Object Storage instead - same
# S3 API, just different values.
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_BUCKET="werkpass-dev"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
